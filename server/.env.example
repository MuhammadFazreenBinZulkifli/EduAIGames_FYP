PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# PostgreSQL (use your host's managed DB values in production)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fyp
DB_USER=postgres
DB_PASSWORD=change_me
# Set true for Railway, Render, Supabase, Neon, etc.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# Public URL of the React app (used in emails and CORS when API is separate)
FRONTEND_URL=https://yourdomain.com
# Comma-separated list if you have multiple frontends (optional)
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Public URL shown in server logs (optional)
# PUBLIC_URL=https://yourdomain.com

# Serve the built React app from the same Node process (recommended single-server deploy)
SERVE_FRONTEND=true
# Override path to dist if needed (default: ../EduAIGames/dist)
# FRONTEND_DIST_PATH=/var/www/eduaigames/dist

# Skip full schema bootstrap on every restart after first deploy (optional)
# SKIP_DB_SETUP=true

# Expose /api/db-check in production (off by default)
# ENABLE_DB_CHECK=true

# SMTP settings for OTP and password reset emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="EduAIGames <your_email@gmail.com>"

# OpenAI API key for EduBot chatbot and AI quiz generation
OPENAI_API_KEY=your_openai_api_key_here
