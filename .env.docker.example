# Docker Compose environment for EduAIGames.
# Copy this file to ".env" (in this same folder) and adjust the values.
# Docker Compose loads ".env" automatically. Anything left unset falls back to
# the defaults declared in docker-compose.yml.

# ---- Database ----
DB_NAME=fyp
DB_USER=postgres
DB_PASSWORD=change_me

# ---- App ----
# Public URL the app is reached at (also used for email links + CORS).
FRONTEND_URL=http://localhost:5000

# ---- Optional integrations (leave blank to disable) ----
OPENAI_API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
