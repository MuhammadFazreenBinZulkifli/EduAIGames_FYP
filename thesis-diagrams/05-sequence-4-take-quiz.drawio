<mxfile host="app.diagrams.net" modified="2026-07-09T12:00:00.000Z" agent="EduAIGames Thesis" version="24.0.0">
  <diagram id="seq-take-quiz" name="Sequence - Student Takes a Quiz">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Sequence Diagram: Student Takes and Submits a Quiz" style="text;html=1;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="600" height="30" as="geometry" />
        </mxCell>

        <!-- Participants -->
        <mxCell id="p1" value="Student" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="50" width="30" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="QuizAnswering.tsx&#10;(React UI)" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="60" width="160" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="Express API&#10;(/api/quizzes)" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="530" y="60" width="150" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="PostgreSQL" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="60" width="140" height="45" as="geometry" />
        </mxCell>

        <!-- Lifelines -->
        <mxCell id="l1" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="95" y="110" as="sourcePoint" /><mxPoint x="95" y="950" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="l2" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="320" y="105" as="sourcePoint" /><mxPoint x="320" y="950" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="l3" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="105" as="sourcePoint" /><mxPoint x="605" y="950" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="l4" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="920" y="105" as="sourcePoint" /><mxPoint x="920" y="950" as="targetPoint" /></mxGeometry></mxCell>

        <!-- Messages -->
        <mxCell id="m1" value="1: Open quiz (/student/quiz/:classId/:quizId)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="95" y="150" as="sourcePoint" /><mxPoint x="320" y="150" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m2" value="2: GET /api/quizzes/:quizId" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="320" y="195" as="sourcePoint" /><mxPoint x="605" y="195" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m3" value="3: SELECT quiz, questions, question_options" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="240" as="sourcePoint" /><mxPoint x="920" y="240" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m4" value="4: quiz with settings (time limit, shuffle, max_attempts)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="285" as="sourcePoint" /><mxPoint x="320" y="285" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m5" value="5: GET /api/quizzes/student/:studentId/quiz/:quizId/attempt-count" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="320" y="330" as="sourcePoint" /><mxPoint x="605" y="330" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m6" value="6: attempt count (block if &gt;= max_attempts)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="375" as="sourcePoint" /><mxPoint x="320" y="375" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m7" value="7: Answer questions (loop); autosave to localStorage; timer runs" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="95" y="430" as="sourcePoint" /><mxPoint x="320" y="430" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m8" value="8: Click Submit (or timer auto-submit)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="95" y="480" as="sourcePoint" /><mxPoint x="320" y="480" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m9" value="9: POST /api/quizzes/attempts/submit {student_id, quiz_id, score, correct_answers, total_questions, responses}" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="320" y="540" as="sourcePoint" /><mxPoint x="605" y="540" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m10" value="10: canStudentAccessQuiz - verify class membership" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="590" as="sourcePoint" /><mxPoint x="920" y="590" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m11" value="11: countStudentAttempts - re-check max_attempts (403 if exceeded)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="640" as="sourcePoint" /><mxPoint x="920" y="640" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m12" value="12: INSERT INTO student_quiz_attempts (score, responses JSONB)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="690" as="sourcePoint" /><mxPoint x="920" y="690" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m13" value="13: INSERT INTO notifications (recipient = instructor, type = quiz_attempt)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="740" as="sourcePoint" /><mxPoint x="920" y="740" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m14" value="14: 201 {attempt}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="790" as="sourcePoint" /><mxPoint x="320" y="790" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m15" value="15: Show score / review (per show_results_after)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="320" y="840" as="sourcePoint" /><mxPoint x="95" y="840" as="targetPoint" /></mxGeometry></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
