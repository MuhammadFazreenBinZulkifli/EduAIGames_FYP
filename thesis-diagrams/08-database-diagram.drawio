        <!-- Legend note -->
        <mxCell id="legend" value="Database notes:&#10;- «PK» primary key, «FK» foreign key, «unique» composite or single-column unique constraint.&#10;- ON DELETE CASCADE on most child tables; quizzes.class_id and quizzes.course_id use SET NULL.&#10;- email_otp_codes has no FK to users (OTP issued before account exists).&#10;- admin_notifications and platform_settings are standalone tables (no FK).&#10;- admin_audit_log.admin_id uses ON DELETE SET NULL to preserve audit history.&#10;- Schema sources: setupDatabase.ts, gameQueries.ts, institutionServices.ts, notificationQueries.ts, adminInfrastructure.ts, index.ts." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;size=20;" vertex="1" parent="1">
