        <!-- ===== Column 1: Tenancy & Users ===== -->
        <mxCell id="cPlan" value="&lt;p style=&quot;margin:4px;text-align:center&quot;&gt;«table»&lt;br/&gt;&lt;b&gt;plans&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:4px;margin-left:6px&quot;&gt;+ id: int «PK»&lt;br/&gt;+ name: varchar(80) «unique»&lt;br/&gt;+ price: numeric(10,2)&lt;br/&gt;+ features: jsonb&lt;br/&gt;+ is_default: boolean&lt;br/&gt;+ created_at: timestamptz&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1">
