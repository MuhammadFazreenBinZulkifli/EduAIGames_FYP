        <mxCell id="cInstitution" value="&lt;p style=&quot;margin:4px;text-align:center&quot;&gt;«table»&lt;br/&gt;&lt;b&gt;institutions&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:4px;margin-left:6px&quot;&gt;+ id: int «PK»&lt;br/&gt;+ name: varchar(160)&lt;br/&gt;+ slug: varchar(120) «unique»&lt;br/&gt;+ status: varchar(20)&lt;br/&gt;+ plan_id: int «FK plans»&lt;br/&gt;+ seats_limit: int&lt;br/&gt;+ email_domains: text[]&lt;br/&gt;+ feature_overrides: jsonb&lt;br/&gt;+ primary_color: varchar(20)&lt;br/&gt;+ logo_url: text&lt;br/&gt;+ is_default: boolean&lt;br/&gt;+ created_at: timestamptz&lt;br/&gt;+ updated_at: timestamptz&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1">
