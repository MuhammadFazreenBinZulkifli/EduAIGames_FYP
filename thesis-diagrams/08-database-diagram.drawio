        <mxCell id="cOtp" value="&lt;p style=&quot;margin:4px;text-align:center&quot;&gt;«table»&lt;br/&gt;&lt;b&gt;email_otp_codes&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:4px;margin-left:6px&quot;&gt;+ id: int «PK»&lt;br/&gt;+ email: varchar(255)&lt;br/&gt;+ purpose: OtpPurpose&lt;br/&gt;+ otp_hash: varchar(255) «sha256»&lt;br/&gt;+ payload: jsonb&lt;br/&gt;+ expires_at: timestamp&lt;br/&gt;+ consumed: boolean&lt;br/&gt;+ created_at: timestamp&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1">
