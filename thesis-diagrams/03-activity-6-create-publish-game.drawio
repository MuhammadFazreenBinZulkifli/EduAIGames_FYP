<mxfile host="app.diagrams.net" modified="2026-07-09T12:00:00.000Z" agent="EduAIGames Thesis" version="24.0.0">
  <diagram id="act-create-game" name="Activity - Instructor Creates and Publishes a Game">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1450" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Activity Diagram: Instructor Creates a Learning Game and Publishes It to a Class" style="text;html=1;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="800" height="30" as="geometry" />
        </mxCell>

        <mxCell id="laneInstructor" value="Instructor" style="swimlane;html=1;startSize=30;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="480" height="1350" as="geometry" />
        </mxCell>
        <mxCell id="laneSystem" value="EduAIGames System" style="swimlane;html=1;startSize=30;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="50" width="500" height="1350" as="geometry" />
        </mxCell>

        <!-- Instructor lane -->
        <mxCell id="start" style="ellipse;html=1;fillColor=#000000;" vertex="1" parent="laneInstructor">
          <mxGeometry x="225" y="50" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="Open Content Maker Hub&#10;(/instructor/studio) and choose&#10;game type: Maze / Snake /&#10;Breakout / Trivia Race" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneInstructor">
          <mxGeometry x="130" y="120" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="Select one of own quizzes&#10;to power the game" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneInstructor">
          <mxGeometry x="130" y="250" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="Quiz&#10;available?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="laneInstructor">
          <mxGeometry x="160" y="350" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="Create a quiz first&#10;(see Create Quiz flow)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneInstructor">
          <mxGeometry x="20" y="360" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="Configure game: title, description,&#10;ghost mode, game-specific settings&#10;(speed, layout, difficulty)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneInstructor">
          <mxGeometry x="130" y="470" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="Save game" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneInstructor">
          <mxGeometry x="130" y="590" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="Publish to a&#10;class now?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="laneInstructor">
          <mxGeometry x="160" y="790" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="Choose target class&#10;(owned by instructor)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneInstructor">
          <mxGeometry x="130" y="920" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a11" value="Game stays in library&#10;for later publishing" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneInstructor">
          <mxGeometry x="20" y="1060" width="150" height="60" as="geometry" />
        </mxCell>

        <!-- System lane -->
        <mxCell id="a6" value="Insert into games table&#10;(instructor_id, quiz_id, game_type,&#10;ghost_enabled, settings JSON)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneSystem">
          <mxGeometry x="140" y="585" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a8" value="Upsert row in class_games&#10;(unique class_id + game_id;&#10;refresh published_at)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneSystem">
          <mxGeometry x="140" y="915" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a9" value="Notify enrolled students:&#10;&quot;new game published&quot;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneSystem">
          <mxGeometry x="140" y="1030" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a10" value="Game visible in class content;&#10;students can play it" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneSystem">
          <mxGeometry x="140" y="1130" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="end1" style="ellipse;html=1;shape=endState;fillColor=#000000;" vertex="1" parent="laneSystem">
          <mxGeometry x="240" y="1240" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="start" target="a1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="a2" target="d1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="d1" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="a3" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="d1" target="a4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="POST /api/games" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;fontSize=10;" edge="1" parent="1" source="a5" target="a6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="a6" target="d2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="d2" target="a11"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="d2" target="a7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" value="POST /api/games/:gameId/publish/:classId" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;fontSize=10;" edge="1" parent="1" source="a7" target="a8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="a8" target="a9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="a9" target="a10"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="a10" target="end1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="a11" target="end1"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
