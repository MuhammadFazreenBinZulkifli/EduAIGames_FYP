<mxfile host="app.diagrams.net" modified="2026-07-09T12:00:00.000Z" agent="EduAIGames Thesis" version="24.0.0">
  <diagram id="act-join-class" name="Activity - Student Joins a Class">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Activity Diagram: Student Joins a Class (Join Code or Browse Public Classes)" style="text;html=1;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="740" height="30" as="geometry" />
        </mxCell>

        <mxCell id="laneStudent" value="Student" style="swimlane;html=1;startSize=30;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="460" height="1150" as="geometry" />
        </mxCell>
        <mxCell id="laneSystem" value="EduAIGames System" style="swimlane;html=1;startSize=30;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="50" width="520" height="1150" as="geometry" />
        </mxCell>

        <!-- Student lane -->
        <mxCell id="start" style="ellipse;html=1;fillColor=#000000;" vertex="1" parent="laneStudent">
          <mxGeometry x="215" y="50" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="Open Join Class page&#10;(/student/join)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneStudent">
          <mxGeometry x="130" y="120" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="Has a join&#10;code?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="laneStudent">
          <mxGeometry x="150" y="220" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="Enter join code" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneStudent">
          <mxGeometry x="30" y="350" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="Browse public classes list" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneStudent">
          <mxGeometry x="250" y="350" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="Select a class and&#10;click Join" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneStudent">
          <mxGeometry x="250" y="440" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a10" value="See class in My Classes&#10;and access its content" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneStudent">
          <mxGeometry x="130" y="950" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- System lane -->
        <mxCell id="a5" value="Look up class by join_code&#10;or class id" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneSystem">
          <mxGeometry x="150" y="440" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="Class exists?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="laneSystem">
          <mxGeometry x="180" y="540" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="Show &quot;Invalid join code /&#10;class not found&quot; error" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneSystem">
          <mxGeometry x="20" y="550" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="Already a&#10;member?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="laneSystem">
          <mxGeometry x="180" y="660" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="Show &quot;Already joined&#10;this class&quot; message" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneSystem">
          <mxGeometry x="20" y="670" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a8" value="Insert row into class_memberships&#10;(unique student_id + class_id)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneSystem">
          <mxGeometry x="150" y="780" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a9" value="Create notification for instructor:&#10;&quot;student joined your class&quot;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneSystem">
          <mxGeometry x="150" y="880" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="end1" style="ellipse;html=1;shape=endState;fillColor=#000000;" vertex="1" parent="laneSystem">
          <mxGeometry x="245" y="1010" width="30" height="30" as="geometry" />
        </mxCell>

