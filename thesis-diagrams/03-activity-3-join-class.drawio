        <mxCell id="e5" value="GET /api/classes/available/all" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;fontSize=10;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="POST /api/classes/student/join-by-code" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;fontSize=10;" edge="1" parent="1" source="a2" target="a5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="POST /api/classes/student/join/:classId" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;fontSize=10;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry" /></mxCell>
