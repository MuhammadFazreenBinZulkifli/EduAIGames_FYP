        <mxCell id="l2" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="315" y="105" as="sourcePoint" /><mxPoint x="315" y="950" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="l3" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="105" as="sourcePoint" /><mxPoint x="605" y="950" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="l4" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="890" y="105" as="sourcePoint" /><mxPoint x="890" y="950" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="l5" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1120" y="105" as="sourcePoint" /><mxPoint x="1120" y="950" as="targetPoint" /></mxGeometry></mxCell>

        <!-- Messages -->
        <mxCell id="m1" value="1: Fill form (username, email, password, role)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="95" y="150" as="sourcePoint" /><mxPoint x="315" y="150" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m2" value="2: POST /api/auth/register/request-otp" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="315" y="200" as="sourcePoint" /><mxPoint x="605" y="200" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m3" value="3: check registration_open, existing email" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="250" as="sourcePoint" /><mxPoint x="890" y="250" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m4" value="4: INSERT INTO email_otp_codes (otp_hash, payload, expires_at)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="300" as="sourcePoint" /><mxPoint x="890" y="300" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m5" value="5: sendOtpEmail (6-digit code, 10-min expiry)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="350" as="sourcePoint" /><mxPoint x="1120" y="350" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m6" value="6: OTP email delivered to inbox" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1120" y="400" as="sourcePoint" /><mxPoint x="95" y="400" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m7" value="7: 200 &quot;OTP sent to your email&quot;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="440" as="sourcePoint" /><mxPoint x="315" y="440" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m8" value="8: Enter OTP code" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="95" y="490" as="sourcePoint" /><mxPoint x="315" y="490" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m9" value="9: POST /api/auth/register/verify-otp {email, otp}" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="315" y="540" as="sourcePoint" /><mxPoint x="605" y="540" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m10" value="10: resolve institution by email domain, check seats_limit" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="590" as="sourcePoint" /><mxPoint x="890" y="590" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m11" value="11: SELECT latest OTP, verify hash + expiry, UPDATE consumed=TRUE" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="640" as="sourcePoint" /><mxPoint x="890" y="640" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m12" value="12: INSERT INTO users (account_status = pending | approved)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="690" as="sourcePoint" /><mxPoint x="890" y="690" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m13" value="13: INSERT INTO admin_notifications (pending_registration)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="740" as="sourcePoint" /><mxPoint x="890" y="740" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m14" value="14: 201 {user, pendingApproval}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="790" as="sourcePoint" /><mxPoint x="315" y="790" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m15" value="15: Show &quot;Registration submitted, wait for admin approval&quot;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="315" y="840" as="sourcePoint" /><mxPoint x="95" y="840" as="targetPoint" /></mxGeometry></mxCell>

