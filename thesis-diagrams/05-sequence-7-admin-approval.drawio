<mxfile host="app.diagrams.net" modified="2026-07-09T12:00:00.000Z" agent="EduAIGames Thesis" version="24.0.0">
  <diagram id="seq-admin-approval" name="Sequence - Admin Approves Registration">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Sequence Diagram: Admin Approves or Rejects a Pending Registration" style="text;html=1;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="750" height="30" as="geometry" />
        </mxCell>

        <!-- Participants -->
        <mxCell id="p1" value="Admin" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="50" width="30" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="AdminDashboard.tsx&#10;(Approvals tab)" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="60" width="170" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="Express API&#10;(/api/admin, requireAdmin)" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="60" width="190" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="PostgreSQL" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="870" y="60" width="140" height="45" as="geometry" />
        </mxCell>

        <!-- Lifelines -->
        <mxCell id="l1" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="95" y="110" as="sourcePoint" /><mxPoint x="95" y="800" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="l2" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="325" y="105" as="sourcePoint" /><mxPoint x="325" y="800" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="l3" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="635" y="105" as="sourcePoint" /><mxPoint x="635" y="800" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="l4" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="940" y="105" as="sourcePoint" /><mxPoint x="940" y="800" as="targetPoint" /></mxGeometry></mxCell>

        <!-- Messages -->
        <mxCell id="m1" value="1: Open Approvals tab" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="95" y="150" as="sourcePoint" /><mxPoint x="325" y="150" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m2" value="2: GET /api/admin/users/pending (X-Admin-Id header)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="325" y="200" as="sourcePoint" /><mxPoint x="635" y="200" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m3" value="3: SELECT users WHERE account_status = 'pending'" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="635" y="250" as="sourcePoint" /><mxPoint x="940" y="250" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m4" value="4: pending users[]" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="940" y="295" as="sourcePoint" /><mxPoint x="635" y="295" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m5" value="5: Display pending list" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="325" y="340" as="sourcePoint" /><mxPoint x="95" y="340" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m6" value="6: Click Approve (or Reject)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="95" y="390" as="sourcePoint" /><mxPoint x="325" y="390" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m7" value="7: POST /api/admin/users/:userId/approve (or /reject)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="325" y="440" as="sourcePoint" /><mxPoint x="635" y="440" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m8" value="8: UPDATE users SET account_status = 'approved' (or 'rejected')" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="635" y="490" as="sourcePoint" /><mxPoint x="940" y="490" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m9" value="9: INSERT INTO admin_audit_log (admin_id, action, target user)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="635" y="540" as="sourcePoint" /><mxPoint x="940" y="540" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m10" value="10: 200 {user}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="635" y="590" as="sourcePoint" /><mxPoint x="325" y="590" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m11" value="11: Refresh list; user can now log in (or is blocked)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="325" y="640" as="sourcePoint" /><mxPoint x="95" y="640" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m12" value="12: (alt) POST /api/admin/users/approve-all for bulk approval" style="html=1;verticalAlign=bottom;endArrow=block;dashed=1;fontSize=11;fontStyle=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="325" y="710" as="sourcePoint" /><mxPoint x="635" y="710" as="targetPoint" /></mxGeometry></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
