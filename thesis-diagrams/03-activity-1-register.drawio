<mxfile host="app.diagrams.net" modified="2026-07-09T12:00:00.000Z" agent="EduAIGames Thesis" version="24.0.0">
  <diagram id="act-register" name="Activity - Register with OTP and Admin Approval">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Activity Diagram: Account Registration with Email OTP and Admin Approval" style="text;html=1;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="700" height="30" as="geometry" />
        </mxCell>

        <!-- Swimlanes -->
        <mxCell id="laneGuest" value="Guest" style="swimlane;html=1;startSize=30;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="380" height="1400" as="geometry" />
        </mxCell>
        <mxCell id="laneSystem" value="EduAIGames System" style="swimlane;html=1;startSize=30;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="50" width="500" height="1400" as="geometry" />
        </mxCell>
        <mxCell id="laneAdmin" value="Admin" style="swimlane;html=1;startSize=30;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="920" y="50" width="380" height="1400" as="geometry" />
        </mxCell>

        <!-- Guest lane -->
        <mxCell id="start" style="ellipse;html=1;fillColor=#000000;" vertex="1" parent="laneGuest">
          <mxGeometry x="170" y="50" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="Open /register and fill form&#10;(username, email, password, role)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneGuest">
          <mxGeometry x="90" y="120" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="Submit registration request" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneGuest">
          <mxGeometry x="90" y="220" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a8" value="Enter 6-digit OTP code&#10;from email" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneGuest">
          <mxGeometry x="90" y="640" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a15" value="See &quot;Registration submitted,&#10;wait for admin approval&quot;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneGuest">
          <mxGeometry x="90" y="1090" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- System lane -->
        <mxCell id="d1" value="Input valid and&#10;registration_open?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="laneSystem">
          <mxGeometry x="170" y="205" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="Show validation /&#10;registration-closed error" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneSystem">
          <mxGeometry x="30" y="310" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="Email already&#10;registered or pending?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="laneSystem">
          <mxGeometry x="170" y="330" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="Show &quot;Email already&#10;registered&quot; error" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneSystem">
          <mxGeometry x="30" y="440" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="Hash password (bcrypt) and&#10;store OTP record in email_otp_codes&#10;(expires in 10 minutes)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneSystem">
          <mxGeometry x="140" y="440" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="Send OTP email via&#10;SMTP service" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneSystem">
          <mxGeometry x="140" y="545" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="OTP valid and&#10;not expired?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="laneSystem">
          <mxGeometry x="170" y="640" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="Show &quot;Invalid or expired&#10;OTP&quot; error" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneSystem">
          <mxGeometry x="30" y="750" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="Institution seat&#10;available?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="laneSystem">
          <mxGeometry x="170" y="760" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a9" value="Show &quot;Seat limit&#10;reached&quot; error" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneSystem">
          <mxGeometry x="30" y="870" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a10" value="Create user account&#10;(account_status = pending when&#10;require_admin_approval is on)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneSystem">
          <mxGeometry x="140" y="880" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d5" value="Approval&#10;required?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="laneSystem">
          <mxGeometry x="170" y="990" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a11" value="Insert admin notification&#10;(pending_registration)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneSystem">
          <mxGeometry x="140" y="1105" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a16" value="Show &quot;Account created,&#10;you can now log in&quot;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneSystem">
          <mxGeometry x="30" y="1105" width="100" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a14" value="Update account_status to&#10;approved or rejected;&#10;write admin_audit_log entry" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneSystem">
          <mxGeometry x="140" y="1250" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="end1" style="ellipse;html=1;shape=endState;fillColor=#000000;" vertex="1" parent="laneSystem">
          <mxGeometry x="235" y="1350" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- Admin lane -->
        <mxCell id="a12" value="Review pending registration&#10;in Approvals tab" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneAdmin">
          <mxGeometry x="90" y="1105" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d6" value="Approve?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="laneAdmin">
          <mxGeometry x="110" y="1200" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="start" target="a1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="POST /api/auth/register/request-otp" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;fontSize=10;" edge="1" parent="1" source="a2" target="d1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="d1" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="a3" target="a1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="d2" target="a4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="a4" target="a1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="d2" target="a5"><mxGeometry relative="1" as="geometry" /></mxCell>
