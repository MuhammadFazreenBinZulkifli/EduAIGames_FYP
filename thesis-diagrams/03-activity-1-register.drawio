        <mxCell id="e24" value="POST /api/admin/users/:userId/approve or /reject" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;fontSize=10;" edge="1" parent="1" source="d6" target="a14"><mxGeometry relative="1" as="geometry" /></mxCell>
