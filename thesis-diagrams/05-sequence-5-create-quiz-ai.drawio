        <mxCell id="m7" value="7: 200 {questions[]}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="445" as="sourcePoint" /><mxPoint x="315" y="445" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m8" value="8: Prefill question editor with generated questions" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="315" y="495" as="sourcePoint" /><mxPoint x="95" y="495" as="targetPoint" /></mxGeometry></mxCell>
