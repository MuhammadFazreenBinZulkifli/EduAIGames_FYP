        <!-- Messages -->
        <mxCell id="m1" value="1: Enter quiz details; open AI generator (topic, difficulty, count, type)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="95" y="150" as="sourcePoint" /><mxPoint x="315" y="150" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m2" value="2: POST /api/chat/quiz-generate (feature-gated: ai_quiz_enabled, openai_enabled)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="315" y="200" as="sourcePoint" /><mxPoint x="600" y="200" as="targetPoint" /></mxGeometry></mxCell>
