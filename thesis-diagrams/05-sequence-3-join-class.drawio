          <mxGeometry x="530" y="60" width="150" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="PostgreSQL" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="60" width="140" height="45" as="geometry" />
        </mxCell>

        <!-- Lifelines -->
        <mxCell id="l1" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="95" y="110" as="sourcePoint" /><mxPoint x="95" y="800" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="l2" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="320" y="105" as="sourcePoint" /><mxPoint x="320" y="800" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="l3" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="105" as="sourcePoint" /><mxPoint x="605" y="800" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="l4" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="920" y="105" as="sourcePoint" /><mxPoint x="920" y="800" as="targetPoint" /></mxGeometry></mxCell>

        <!-- Messages -->
        <mxCell id="m1" value="1: Enter join code and click Join" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="95" y="150" as="sourcePoint" /><mxPoint x="320" y="150" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m2" value="2: POST /api/classes/student/join-by-code {student_id, join_code}" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="320" y="200" as="sourcePoint" /><mxPoint x="605" y="200" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m3" value="3: SELECT * FROM classes WHERE join_code = $1" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="250" as="sourcePoint" /><mxPoint x="920" y="250" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m4" value="4: class row (404 if not found)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="920" y="295" as="sourcePoint" /><mxPoint x="605" y="295" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m5" value="5: check existing membership (unique student_id + class_id)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="345" as="sourcePoint" /><mxPoint x="920" y="345" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m6" value="6: INSERT INTO class_memberships (student_id, class_id)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="395" as="sourcePoint" /><mxPoint x="920" y="395" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m7" value="7: INSERT INTO notifications (recipient = instructor, type = student_joined)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="445" as="sourcePoint" /><mxPoint x="920" y="445" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m8" value="8: 201 {class}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="495" as="sourcePoint" /><mxPoint x="320" y="495" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m9" value="9: Show success; class appears in My Classes" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="320" y="545" as="sourcePoint" /><mxPoint x="95" y="545" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m10" value="10: (alt) GET /api/classes/available/all to browse public classes,&#10;then POST /api/classes/student/join/:classId" style="html=1;verticalAlign=bottom;endArrow=block;dashed=1;fontSize=11;fontStyle=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="320" y="640" as="sourcePoint" /><mxPoint x="605" y="640" as="targetPoint" /></mxGeometry></mxCell>

      </root>
