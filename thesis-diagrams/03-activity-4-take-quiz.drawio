<mxfile host="app.diagrams.net" modified="2026-07-09T12:00:00.000Z" agent="EduAIGames Thesis" version="24.0.0">
  <diagram id="act-take-quiz" name="Activity - Student Takes a Quiz">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1650" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Activity Diagram: Student Takes and Submits a Quiz" style="text;html=1;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="600" height="30" as="geometry" />
        </mxCell>

        <mxCell id="laneStudent" value="Student" style="swimlane;html=1;startSize=30;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="460" height="1550" as="geometry" />
        </mxCell>
        <mxCell id="laneSystem" value="EduAIGames System" style="swimlane;html=1;startSize=30;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="50" width="520" height="1550" as="geometry" />
        </mxCell>

        <!-- Student lane -->
        <mxCell id="start" style="ellipse;html=1;fillColor=#000000;" vertex="1" parent="laneStudent">
          <mxGeometry x="215" y="50" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="Open Pending Quizzes&#10;(/student/quiz) and select a quiz" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneStudent">
          <mxGeometry x="130" y="120" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="Answer questions&#10;(answers autosaved locally&#10;via quizProgress)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneStudent">
          <mxGeometry x="130" y="620" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="Time limit&#10;expired?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="laneStudent">
          <mxGeometry x="150" y="730" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="All questions&#10;answered and student&#10;clicks Submit?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="laneStudent">
          <mxGeometry x="150" y="850" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a12" value="View results / review&#10;(per show_results_after policy)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneStudent">
          <mxGeometry x="130" y="1370" width="210" height="60" as="geometry" />
        </mxCell>

        <!-- System lane -->
        <mxCell id="a2" value="Load quiz, questions and options;&#10;check attempt count" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneSystem">
          <mxGeometry x="150" y="120" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="Attempts&#10;remaining&#10;(max_attempts)?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="laneSystem">
          <mxGeometry x="180" y="220" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="Block quiz: &quot;Maximum&#10;attempts reached&quot;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneSystem">
          <mxGeometry x="20" y="235" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="Saved local&#10;progress exists?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="laneSystem">
          <mxGeometry x="180" y="350" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a4a" value="Restore saved answers&#10;(resume quiz)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneSystem">
          <mxGeometry x="60" y="480" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a4b" value="Start fresh: apply shuffle_questions /&#10;shuffle_options; start timer if&#10;time_limit_minutes is set" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneSystem">
          <mxGeometry x="260" y="480" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="Auto-submit current answers" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneSystem">
          <mxGeometry x="150" y="990" width="230" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="Verify class membership&#10;(canStudentAccessQuiz) and&#10;re-check max_attempts" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneSystem">
          <mxGeometry x="150" y="1080" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a8" value="Grade attempt and insert into&#10;student_quiz_attempts (score,&#10;correct_answers, total_questions,&#10;responses JSONB)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneSystem">
          <mxGeometry x="150" y="1190" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a9" value="Notify instructor of&#10;the quiz attempt" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneSystem">
          <mxGeometry x="150" y="1310" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="end1" style="ellipse;html=1;shape=endState;fillColor=#000000;" vertex="1" parent="laneSystem">
          <mxGeometry x="250" y="1440" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="start" target="a1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="GET /api/quizzes/:quizId + attempt-count" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;fontSize=10;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="a2" target="d1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="d1" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="d2" target="a4a"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="d2" target="a4b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="a4a" target="a5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="a4b" target="a5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="a5" target="d3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="d3" target="a6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="d3" target="d4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" value="not yet" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;fontSize=10;" edge="1" parent="1" source="d4" target="a5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14" value="submit" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;fontSize=10;" edge="1" parent="1" source="d4" target="a7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="a6" target="a7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e16" value="POST /api/quizzes/attempts/submit" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;fontSize=10;" edge="1" parent="1" source="a7" target="a8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="a8" target="a9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e18" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="a9" target="a12"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e19" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="a12" target="end1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e20" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="a3" target="end1"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
