<mxfile host="app.diagrams.net" modified="2026-07-09T12:00:00.000Z" agent="EduAIGames Thesis" version="24.0.0">
  <diagram id="act-admin-approval" name="Activity - Admin Approves or Rejects Registration">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Activity Diagram: Admin Approves or Rejects a Pending Registration" style="text;html=1;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="700" height="30" as="geometry" />
        </mxCell>

        <mxCell id="laneAdmin" value="Admin" style="swimlane;html=1;startSize=30;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="480" height="1200" as="geometry" />
        </mxCell>
        <mxCell id="laneSystem" value="EduAIGames System" style="swimlane;html=1;startSize=30;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="50" width="500" height="1200" as="geometry" />
        </mxCell>

        <!-- Admin lane -->
        <mxCell id="start" style="ellipse;html=1;fillColor=#000000;" vertex="1" parent="laneAdmin">
          <mxGeometry x="225" y="50" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="Receive notification of&#10;pending registration&#10;(admin_notifications)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneAdmin">
          <mxGeometry x="130" y="120" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="Open Approvals tab in&#10;Admin Dashboard" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneAdmin">
          <mxGeometry x="130" y="230" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="Review applicant details&#10;(username, email, role,&#10;institution)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneAdmin">
          <mxGeometry x="130" y="440" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="Decision?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="laneAdmin">
          <mxGeometry x="160" y="560" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="Click Approve&#10;(or Approve All)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneAdmin">
          <mxGeometry x="40" y="700" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="Click Reject" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneAdmin">
          <mxGeometry x="280" y="700" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- System lane -->
        <mxCell id="a3" value="Load pending users&#10;(account_status = pending)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneSystem">
          <mxGeometry x="140" y="330" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="Set account_status = approved" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneSystem">
          <mxGeometry x="30" y="800" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a8" value="Set account_status = rejected" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneSystem">
          <mxGeometry x="270" y="800" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a9" value="Write admin_audit_log entry&#10;(action, target user, admin id)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneSystem">
          <mxGeometry x="140" y="900" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a10" value="User can now log in (approved)&#10;or is blocked with&#10;ACCOUNT_REJECTED (rejected)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneSystem">
          <mxGeometry x="140" y="1000" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="end1" style="ellipse;html=1;shape=endState;fillColor=#000000;" vertex="1" parent="laneSystem">
          <mxGeometry x="240" y="1110" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="start" target="a1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="GET /api/admin/users/pending" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;fontSize=10;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="a4" target="d1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="approve" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="d1" target="a5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="reject" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="d1" target="a6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="POST /api/admin/users/:userId/approve" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;fontSize=10;" edge="1" parent="1" source="a5" target="a7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="POST /api/admin/users/:userId/reject" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;fontSize=10;" edge="1" parent="1" source="a6" target="a8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="a7" target="a9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="a8" target="a9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="a9" target="a10"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="a10" target="end1"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
